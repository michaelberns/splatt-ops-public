# Settings and secrets for splatt-ops. Copy this file to .env and fill it
# in; .env is gitignored. Everything in the repo reads its secrets from
# this one file. docs/INSTALL.md explains where each value comes from.

# ---- Required -------------------------------------------------------------

# Todoist API token (Todoist Settings > Integrations > Developer).
TODOIST_API_TOKEN=
# The PocketBase superuser created during install. Used by the daemon, the
# tools and the MCP servers.
PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=
# Telegram bot and chat for general notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Telegram bot and chat for the ops channel (validator results, summaries).
TELEGRAM_BOT_TOKEN_OPS=
TELEGRAM_CHAT_ID_OPS=

# ---- Optional -------------------------------------------------------------
# Leave these commented out to use the defaults.

# PocketBase address, if not the default http://127.0.0.1:8090.
# SPLATT_PB_URL=http://127.0.0.1:8090
# Project files server address, if not the default http://127.0.0.1:8092.
# SPLATT_PLAYBOOK_URL=http://127.0.0.1:8092
# Folder that holds "SS Folders", if not the default ~/Documents/Splatt.
# SPLATT_ROOT=
# The project folders themselves, for bin/start, the files server and the
# guards, if not ~/Documents/Splatt/SS Folders. Keep it inside SPLATT_ROOT.
# SS_FOLDERS_PATH=
# Contact address sent to OpenStreetMap's geocoder by tools/geocode_clients.py.
# GEOCODER_CONTACT_EMAIL=splatt-ops@example.com
# Cloudflare API token with "Cloudflare Pages: Edit", for bin/publish-dashboard.
# CLOUDFLARE_API_TOKEN=
# Cloudflare account id (shown on any Cloudflare dashboard page).
# CLOUDFLARE_ACCOUNT_ID=
# Cloudflare Pages project name for the hosted dashboard.
# CF_PAGES_PROJECT=splatt-ops-demo
